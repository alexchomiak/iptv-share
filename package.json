{
  "name": "iptv-share",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "NODE_ENV=development nodemon src/server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "capture:espn": "node scripts/capture-espn-live.mjs",
    "build": "vite build",
    "start": "node src/server/index.js",
    "check": "npm run build",
    "test": "node --test test/espn_cache.test.mjs test/snapshot_cleanup.test.mjs test/nfl_epg.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.1",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "hls.js": "^1.5.20",
    "mpegts.js": "^1.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "puppeteer": "^25.9.0"
  }
}
